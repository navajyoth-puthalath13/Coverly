# "Request a template" form → email delivery (Resend)
# The app and the form build/run without these; they're only needed for the
# /api/requests route to actually send you the submission email.

# Required to send. Create a key at https://resend.com (free tier available).
RESEND_API_KEY=

# Optional. Where submissions are emailed. Defaults to the project owner's email.
# CONTACT_EMAIL=you@example.com

# Optional. Verified sender. Defaults to Resend's shared sender for quick testing;
# set a verified domain sender (e.g. "Coverly <noreply@yourdomain.com>") for prod.
# RESEND_FROM=Coverly <onboarding@resend.dev>
