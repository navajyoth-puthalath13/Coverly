# "Request a template" form → delivery channels for /api/requests
# The app and form build/run without these. Configure at least one channel so
# submissions actually reach you; whichever is set runs (both can run together).

# ── Channel 1: GitHub issue ──────────────────────────────────────────────────
# Each request becomes an issue in your repo, labelled "new template".
# Create a fine-grained token with "Issues: Read and write" on the Coverly repo
# at https://github.com/settings/tokens  (classic token with "repo" also works).
GITHUB_ISSUE_TOKEN=

# ── Channel 2: Email (Resend) ────────────────────────────────────────────────
# Each request is emailed to you (and carries the optional reference image).
# Create a key at https://resend.com (free tier available).
RESEND_API_KEY=

# Optional. Where submissions are emailed. Defaults to the project owner's email.
# CONTACT_EMAIL=you@example.com

# Optional. Verified sender. Defaults to Resend's shared sender for quick testing;
# set a verified domain sender (e.g. "Coverly <noreply@yourdomain.com>") for prod.
# RESEND_FROM=Coverly <onboarding@resend.dev>
